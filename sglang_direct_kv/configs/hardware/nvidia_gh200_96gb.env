# Capability profile for a single NVIDIA GH200 accelerator with 96 GB memory.
#
# This profile intentionally scales pressure up from the A10G profile so the
# larger device does not look artificially easy. Use the A10G profile for a
# strict apples-to-apples comparison.

: "${HARDWARE_VENDOR:=nvidia}"
: "${HARDWARE_RUNTIME:=cuda}"
: "${GPU_MEMORY_GB:=96}"

: "${MAX_TOTAL_TOKENS:=98304}"
: "${HICACHE_SIZE_GB:=32}"
: "${MEM_FRACTION_STATIC:=0.80}"
: "${REPORT_BUILDER_MODE:=lightweight}"
: "${GPU_UTIL_SAMPLE_INTERVAL_MS:=100}"

: "${P0_CONTROL_KNOBS:=tool_wait_ms=500 target_prompt_tokens=1024 filler_sessions=0 filler_prompt_tokens=768 session_count=1 concurrency=1}"
: "${P1_MILD_KNOBS:=tool_wait_ms=250 target_prompt_tokens=2048 filler_sessions=16 filler_prompt_tokens=1536 session_count=1 concurrency=8}"
: "${P2_MEDIUM_KNOBS:=tool_wait_ms=100 target_prompt_tokens=4096 filler_sessions=32 filler_prompt_tokens=2048 session_count=1 concurrency=12}"
: "${P3_HIGH_KNOBS:=tool_wait_ms=50 target_prompt_tokens=4096 filler_sessions=64 filler_prompt_tokens=2048 session_count=1 concurrency=16}"
: "${P4_CLIFF_KNOBS:=tool_wait_ms=25 target_prompt_tokens=8192 filler_sessions=96 filler_prompt_tokens=3072 session_count=1 concurrency=24}"
: "${P5_BOSS_QUEUE_KNOBS:=tool_wait_ms=50 target_prompt_tokens=8192 filler_sessions=8 filler_prompt_tokens=3072 session_count=8 concurrency=32}"
