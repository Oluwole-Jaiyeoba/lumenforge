    "all_request_boundary": {
      "display_name": "All Pi Agent Harness request-boundary probes",
      "scenario_selectors": ["pi_request_boundary_coverage"],
      "expected_signal_visibility": ["Pi Agent Harness native request-boundary probe targets only"]
