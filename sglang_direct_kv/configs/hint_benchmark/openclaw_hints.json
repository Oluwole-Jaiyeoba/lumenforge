      "default_injection_level": "session_level",
      "expected_source_class": "provider_automatic",
      "supported_consumer": "Provider prompt cache or gateway",
      "scenario_ids": ["openclaw_provider_session_namespace"],
      "status": "native_request_boundary_observed"
    },
    {
      "id": "cache_ttl",
      "canonical_signal": "Cache TTL",
