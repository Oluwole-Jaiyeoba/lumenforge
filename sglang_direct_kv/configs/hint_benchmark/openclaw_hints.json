      "supported_consumer": "OpenClaw provider/session runtime",
      "scenario_ids": ["openclaw_cached_websocket_prewarm_probe"],
      "status": "different_mechanism_not_observed"
    },
    {
      "id": "cache_hit_feedback",
      "canonical_signal": "Cache-hit feedback",
