      "default_injection_level": "cache_entry_level",
      "expected_source_class": "provider_config",
      "supported_consumer": "Provider prompt cache",
      "scenario_ids": ["openclaw_provider_cache_config"],
      "status": "provider_managed_not_observed"
    },
    {
      "id": "cache_entry_type",
      "canonical_signal": "Cache entry type",
      "meaning": "OpenClaw cache entry behavior is provider-managed.",
      "raw_fields": ["cache_control.type", "messages.*.content.*.cache_control.type"],
      "default_injection_level": "cache_entry_level",
      "expected_source_class": "provider_config",
      "supported_consumer": "Provider prompt cache",
      "scenario_ids": ["openclaw_provider_cache_config"],
      "status": "provider_managed_not_observed"
    },
    {
      "id": "speculative_prefill",
      "canonical_signal": "Speculative prefill",
