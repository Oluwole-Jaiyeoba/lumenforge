# Backend-only SGLang runtime. Harness CLIs, credentials, controller policy,
# gateway orchestration, and reports intentionally stay on the host.
#
# Build this image on the target GPU machine so Docker selects that machine's
# native architecture. The runtime capability probe must pass before use.

ARG BASE_IMAGE=nvidia/cuda:12.4.1-devel-ubuntu22.04
FROM ${BASE_IMAGE}

ARG SGLANG_VERSION=0.5.10.post1

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      git \
      libnuma1 \
      python3 \
      python3-dev \
      python3-pip \
      python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip setuptools wheel \
    && python3 -m pip install "sglang[all]==${SGLANG_VERSION}" \
    && python3 -m pip check

# The repository is mounted read-only at runtime. Its SGLang adapter and trace
# hooks therefore match the checked-out controller experiment exactly.
WORKDIR /workspace
CMD ["python3", "-m", "sglang.launch_server", "--help"]
