# Scenario 1 reference: isolated ready-time scheduling.
# Load this file before invoking run_harness_deadline_pressure.sh.

HARDWARE_PROFILE=nvidia_a10g_24gb
HARNESSES=hatcher
PRESSURE_LEVELS=p3_high
MODES="no_prefetch controller_ready_time_gpu_backfill"
P3_HIGH_KNOBS="tool_wait_ms=50 target_prompt_tokens=4096 filler_sessions=15 filler_prompt_tokens=1536 session_count=1 concurrency=6"
FILLER_REPLAY_DEADLINES=1
FILLER_BACKLOG_MODE=once
FILLER_BACKLOG_TARGET=0
FILLER_BACKLOG_TOTAL=0
TOOL_WAIT_PROFILE=custom
TOOL_WAIT_PROFILE_SPEC="very_short:20:100-500,short:35:1000-5000,medium:30:10000-30000,long:15:60000-120000"
TOOL_WAIT_SEED=20260916
TASK_REPLAY_STEPS=2
WORKLOAD_SHAPE_MODE_INDEPENDENT=1
AGENTIC_WORKLOAD_PROFILE=synthetic_pressure
TRACE_PROFILE=full_debug
TRACE_CONTROLLER_DECISIONS=1
TRACE_IDLE_GAP_AUDIT=1
TRACE_REPLAY_FRICTION_DEEP_DIVE=1
TRACE_REPLAY_BLOCKERS=1
TRACE_REPLAY_BLOCKERS_MAX_IDS=16
TRACE_REPLAY_BLOCKERS_EVENTS="before_acquire,submit"
UPDATE_LATEST=0
